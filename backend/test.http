@baseUrl = http://localhost:8080/customers

### 1. Register a Customer (Success)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "John Doe",
  "email": "john.test@gmail.com",
  "password": "john123",
  "phone": "9876543210"
}

### 1b. Register a Customer (Failure - Duplicate Email)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "Jane Doe",
  "email": "john.test@gmail.com",
  "password": "jane123",
  "phone": "1111111111"
}

### 1c. Register a Customer (Failure - Password too short)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "Short Pass",
  "email": "short@gmail.com",
  "password": "123",
  "phone": "9876543210"
}

### 2. Login (Success)
# This will also set the HttpOnly cookie for subsequent requests
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "john.test@gmail.com",
  "password": "john123"
}

### 2b. Login (Failure - Invalid Credentials)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "john.test@gmail.com",
  "password": "wrongpassword"
}

### 3. My Profile (Protected Route)
# This request will automatically send the HttpOnly cookie set by the Login request
GET {{baseUrl}}/me

### 4. Logout
# This will clear the HttpOnly cookie
POST {{baseUrl}}/logout

### 5. Change Password (Bonus)
PATCH {{baseUrl}}/change-password
Content-Type: application/json

{
  "oldPassword": "john123",
  "newPassword": "newjohnpassword456"
}

### ---------------- PRODUCTS (Lab 03) ----------------
@productsUrl = http://localhost:8080/products

### 6. Create Product (Success - 201)
POST {{productsUrl}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "description": "RGB mechanical keyboard with blue switches.",
  "price": 2999,
  "category": "Electronics",
  "image": "https://picsum.photos/seed/keyboard/600/400",
  "stock": 10
}

### 6b. Create Product (Failure - missing field, 400)
POST {{productsUrl}}
Content-Type: application/json

{ "name": "No Price" }

### 6c. Create Product (Failure - invalid price, 400)
POST {{productsUrl}}
Content-Type: application/json

{ "name": "Bad", "description": "x", "price": 0, "category": "Books", "image": "x", "stock": 1 }

### 6d. Create Product (Failure - negative stock, 400)
POST {{productsUrl}}
Content-Type: application/json

{ "name": "Bad", "description": "x", "price": 10, "category": "Books", "image": "x", "stock": -1 }

### 7. Get All Products
GET {{productsUrl}}

### 7b. Search (case-insensitive)
GET {{productsUrl}}?search=KEYboard

### 7c. Category filter
GET {{productsUrl}}?category=Electronics

### 7d. Search + Category
GET {{productsUrl}}?search=keyboard&category=Electronics

### 7e. Sort by price (Bonus)
GET {{productsUrl}}?sort=price_asc

### 7f. Sort by price descending (Bonus)
GET {{productsUrl}}?sort=price_desc

### 8. Get Single Product (paste a real _id)
GET {{productsUrl}}/PASTE_PRODUCT_ID_HERE

### 8b. Invalid ID (400)
GET {{productsUrl}}/abc123

### 8c. Valid but non-existent ID (404)
GET {{productsUrl}}/000000000000000000000000

### ---------------- WISHLIST (Lab 04) ----------------
# Run "2. Login" first so the auth cookie is set.
# Or use Bearer auth: add the header "Authorization: Bearer <token>".
@wishlistUrl = http://localhost:8080/wishlist
@productId = PASTE_PRODUCT_ID_HERE

### 9. Add to wishlist (201)
POST {{wishlistUrl}}/{{productId}}

### 9b. Add same product again (409)
POST {{wishlistUrl}}/{{productId}}

### 9c. Invalid product ID (400)
POST {{wishlistUrl}}/abc123

### 9d. Product not found (404)
POST {{wishlistUrl}}/000000000000000000000000

### 10. Get my wishlist (populated)
GET {{wishlistUrl}}

### 11. Remove from wishlist (200)
DELETE {{wishlistUrl}}/{{productId}}

### 11b. Remove again - not in wishlist (404)
DELETE {{wishlistUrl}}/{{productId}}

### 12. Toggle (Bonus) - returns saved: true/false
PATCH {{wishlistUrl}}/{{productId}}/toggle

### 13. Unauthenticated (run "4. Logout" first) - 401
GET {{wishlistUrl}}

### ---------------- CART (Lab 05) ----------------
# Run "2. Login" first so the auth cookie is set.
@cartUrl = http://localhost:8080/cart

### 14. Add new item (quantity = 1)
POST {{cartUrl}}/{{productId}}

### 14b. Add same item again (quantity = 2)
POST {{cartUrl}}/{{productId}}

### 14c. Product not found (404)
POST {{cartUrl}}/000000000000000000000000

### 15. Get cart (populated products)
GET {{cartUrl}}

### 16. Update quantity
PATCH {{cartUrl}}/{{productId}}
Content-Type: application/json

{ "quantity": 3 }

### 16b. Quantity below 1 (400)
PATCH {{cartUrl}}/{{productId}}
Content-Type: application/json

{ "quantity": 0 }

### 16c. Exceed stock (400)
PATCH {{cartUrl}}/{{productId}}
Content-Type: application/json

{ "quantity": 9999 }

### 17. Remove item (returns updated cart)
DELETE {{cartUrl}}/{{productId}}

### 17b. Remove again - not in cart (404)
DELETE {{cartUrl}}/{{productId}}

### 18. Unauthenticated (run "4. Logout" first) - 401
GET {{cartUrl}}

### ---------------- ORDERS + RAZORPAY (Lab 06) ----------------
# Run "2. Login" first. Add items with "14. Add new item" before creating an order.
@ordersUrl = http://localhost:8080/orders
@orderId = PASTE_SHOPKART_ORDER_ID_HERE

### 19. Create payment order (fake totalAmount is ignored; server calculates the total)
POST {{ordersUrl}}/create-payment-order
Content-Type: application/json

{
  "shippingAddress": {
    "fullName": "Aarav Sharma",
    "phone": "9876543210",
    "addressLine1": "22 MG Road",
    "city": "Bengaluru",
    "state": "Karnataka",
    "pincode": "560001"
  },
  "totalAmount": 1
}

### 19b. Empty cart (400) - run with an empty cart
POST {{ordersUrl}}
Content-Type: application/json

{
  "shippingAddress": { "fullName": "A", "phone": "9876543210", "addressLine1": "x", "city": "x", "state": "x", "pincode": "560001" }
}

### 19c. Invalid shipping data (400)
POST {{ordersUrl}}/create-payment-order
Content-Type: application/json

{
  "shippingAddress": { "fullName": "   ", "phone": "123", "addressLine1": "x", "city": "x", "state": "x", "pincode": "12" }
}

### 20. Fake signature (400 - order stays PENDING, cart NOT cleared)
POST {{ordersUrl}}/verify-payment
Content-Type: application/json

{
  "shopKartOrderId": "{{orderId}}",
  "razorpay_order_id": "PASTE_RAZORPAY_ORDER_ID",
  "razorpay_payment_id": "pay_fake123",
  "razorpay_signature": "fakesignature"
}

### 21. My orders (paid only, newest first)
GET {{ordersUrl}}

### 22. Single order
GET {{ordersUrl}}/{{orderId}}

### 22b. Someone else's / non-existent order (404)
GET {{ordersUrl}}/000000000000000000000000

### 23. Bonus: advance status (PLACED -> CONFIRMED -> SHIPPED -> DELIVERED)
PATCH {{ordersUrl}}/{{orderId}}/status
Content-Type: application/json

{ "status": "CONFIRMED" }
